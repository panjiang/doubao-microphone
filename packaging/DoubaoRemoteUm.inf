; Derived from the Microsoft vhidmini2 sample under MS-PL.

[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ProviderString%
DriverVer=11/06/2026,0.1.0.0
CatalogFile=DoubaoRemoteUm.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%Disk_Description%,,,

[SourceDisksFiles]
DoubaoRemoteUm.dll=1

; ================= Device section =====================

[Manufacturer]
%ManufacturerString%=Microsoft, NTamd64.10.0...22000

[Microsoft.NTamd64.10.0...22000]
%DeviceDesc%=DoubaoRemoteUm, root\DOUBAOREMOTE_UMDF_TRIAL

[DoubaoRemoteUm.NT]
CopyFiles=UMDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[DoubaoRemoteUm.NT.hw]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
AddReg=DeviceSecurity
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[DoubaoRemoteUm.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[DoubaoRemoteUm.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[DoubaoRemoteUm.NT.Wdf]
UmdfService="DoubaoRemoteUm", DoubaoRemoteUm_Install
UmdfServiceOrder=DoubaoRemoteUm
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[DoubaoRemoteUm_Install]
UmdfLibraryVersion=2.33
ServiceBinary="%13%\DoubaoRemoteUm.dll"

; ================= copy files =====================

[UMDriverCopy]
DoubaoRemoteUm.dll

;---------------------------------------------------------------;

[Strings]
ProviderString     ="Doubao Remote Trial"
ManufacturerString ="Doubao Remote Trial"
ClassName          ="Sample Device"
Disk_Description   ="HID minidriver (UMDF v2) Installation Disk"
DeviceDesc         ="Doubao Remote UMDF Trial Keyboard"
WudfRdDisplayName  ="Windows Driver Foundation - User-mode Driver Framework Reflector"

[DeviceSecurity]
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"
